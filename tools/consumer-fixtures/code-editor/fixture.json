{
  "description": "code editor boundary: the kept optional CodeMirror feature entry with the CodeMirror peer group",
  "peerGroup": "code-editor",
  "dependencies": [
    "@codemirror/commands",
    "@codemirror/language",
    "@codemirror/state",
    "@codemirror/view",
    "@lezer/highlight",
    "tailwindcss"
  ],
  "cssSentinels": [
    "hell-code-editor",
    "background-image:linear-gradient(180deg,color-mix(in oklab,var(--color-hell-surface-subtle) 94%,white),var(--color-hell-surface-subtle))"
  ],
  "smoke": {
    "steps": [
      {
        "selector": "hell-code-editor[readonly]",
        "textIncludes": "console.log"
      },
      {
        "selector": "[data-test-id=\"code-editor-forms-status\"]",
        "textIncludes": "Code editor forms ready property-two-way-signal-forms-reactive-template-driven"
      }
    ]
  }
}
