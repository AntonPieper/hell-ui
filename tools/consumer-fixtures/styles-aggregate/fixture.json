{
  "description": "Default Style Bundle mode: one hell-ui/styles.css import through the Tailwind/PostCSS production path with composite peers only",
  "peerGroup": "composite",
  "dependencies": ["tailwindcss"],
  "cssSentinels": [
    "@keyframes hell-pop-in",
    "animation:hell-shimmer 1.6s linear infinite",
    "table-layout:fixed",
    "grid-template-columns:var(--hell-app-sidenav-width) 1fr var(--_hell-app-secondary-track)"
  ],
  "forbiddenCssSentinels": [
    "hell-code-editor",
    "hell-pdf-viewer",
    "[data-hell-skin=glass]hell-toaster"
  ],
  "styleBundleBudget": true,
  "smoke": {
    "stepsFile": "../style-modes-smoke.steps.json"
  }
}
