{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The pr-state, secret-detection-gate, and release:* jobs run these
      // entry points from .gitlab/ci/*.yml, which knip does not read.
      "entry": [
        "tools/merge-state/decide-mr-state.mjs",
        "tools/policy/gate-secret-detection.mjs",
        "tools/release/gitlab-release-projection.mjs"
      ],
      // Consumer fixtures are standalone projects compiled against the packed
      // tarball by tools/package/check-consumer-fixtures.mjs, not repo source.
      "ignore": ["tools/consumer-fixtures/**"],
      // check-main-ruleset.mjs shells out to the system GitHub CLI,
      // gitlab-api.mjs to the GitLab CLI, and build-library.mjs to the Angular
      // CLI; none is an npm dependency here.
      "ignoreBinaries": ["gh", "glab", "ng"],
      "ignoreDependencies": [
        // Declared in pnpm packageExtensions for ng-primitives.
        "@angular/router"
      ],
      // TypeScript's importHelpers option consumes tslib without a source import.
      "ignoreUnresolved": ["tslib"]
    },
    "apps/docs": {
      "ignore": ["src/styles.css", "src/types/raw.d.ts"],
      // The private source condition resolves Hell sources from this workspace.
      "ignoreDependencies": ["tailwind-merge"]
    },
    "packages/angular": {
      // Required to compile ng-primitives' undeclared router import.
      "ignoreDependencies": ["@angular/router"]
    }
  }
}
