{
  "name": "hell-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "start": "pnpm --filter hell-docs start",
    "build": "pnpm run build:lib && pnpm run build:docs",
    "build:lib": "pnpm --filter hell-ui build",
    "build:docs": "pnpm --filter hell-docs build",
    "watch": "pnpm --filter hell-ui watch",
    "change": "changie new",
    "test:unit": "pnpm --filter hell-ui exec ng test hell --watch=false --progress=false --runner-config ../../vitest.config.ts",
    "test:coverage": "pnpm --filter hell-ui exec ng test hell --watch=false --progress=false --runner-config ../../vitest.config.ts --coverage",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "test": "pnpm run test:unit && pnpm run test:tools && pnpm run test:dead-code && pnpm run test:architecture && pnpm run ci:check:entrypoints",
    "lint": "eslint .",
    "test:dead-code": "knip",
    "e2e": "playwright test",
    "generate:entrypoints": "node tools/entrypoints/generate-entrypoint-manifests.mjs",
    "test:architecture": "node tools/architecture/check-architecture.mjs",
    "test:api-report": "node tools/api-report/check-api-reports.mjs",
    "test:changelog": "node tools/release/check-changelog.mjs",
    "test:pr-states": "node tools/merge-state/check-pr-state-policy.mjs",
    "test:secret-detection": "node tools/policy/check-secret-detection-policy.mjs",
    "test:pipeline-shape": "node tools/policy/check-pipeline-shape.mjs",
    "release:prepare": "node tools/release/release-prepare.mjs",
    "verify:main-ruleset": "node tools/policy/check-main-ruleset.mjs",
    "verify:main-policy": "node tools/policy/check-main-policy.mjs",
    "test:main-policy": "node tools/policy/check-main-policy-document.mjs",
    "restore:main-policy": "node tools/policy/restore-main-policy.mjs",
    "verify:release-drift": "node tools/release/gitlab-release-drift.mjs audit",
    "restore:release": "node tools/release/gitlab-release-drift.mjs restore",
    "api-report:update": "node tools/api-report/check-api-reports.mjs --local",
    "release:dry-run": "pnpm run test:changelog && pnpm run lint && pnpm run test:dead-code && pnpm run test:architecture && pnpm run test:tools && pnpm run ci:check:entrypoints && pnpm run test:coverage && pnpm run build:lib && pnpm run test:package-pack && pnpm run test:api-report && pnpm run benchmark:style-bundle --skip-build",
    "benchmark:style-bundle": "node tools/package/check-consumer-fixtures.mjs styles-aggregate",
    "test:consumer-fixtures": "node tools/package/check-consumer-fixtures.mjs",
    "test:package-pack": "publint dist/hell --pack=false --strict && node tools/package/check-package-pack.mjs",
    "ci:install": "pnpm install --frozen-lockfile",
    "ci:playwright:chromium": "pnpm exec playwright install --with-deps chromium",
    "ci:test:unit": "pnpm run test:coverage",
    "ci:test:static": "pnpm run lint && pnpm run test:dead-code && pnpm run test:architecture && pnpm run test:pr-states && pnpm run test:secret-detection && pnpm run test:pipeline-shape && pnpm run test:main-policy && pnpm run test:tools",
    "ci:test:release-notes": "pnpm run test:changelog",
    "ci:test:e2e": "pnpm exec playwright test",
    "ci:test:consumer-fixtures": "pnpm run test:consumer-fixtures",
    "ci:test:consumer-fixtures:shard": "node tools/package/run-consumer-fixture-shard.mjs",
    "ci:build:lib": "pnpm run build:lib",
    "ci:build:docs:prepared": "pnpm run build:docs",
    "ci:check:entrypoints": "node tools/entrypoints/generate-entrypoint-manifests.mjs --check",
    "ci:pack:lib": "pnpm run test:package-pack -- --pack-destination artifacts/package",
    "ci:test:api-report:prepared": "pnpm run test:api-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "angular-eslint": "catalog:",
    "changie": "^1.25.1",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "publint": "^0.3.21",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^7.3.5",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  }
}
